{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "sync-web": "node scripts/sync-web.cjs",
    "start": "expo start",
    "mobile": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "server": "node server/index.js",
    "test:server": "node --test server/test/*.test.js",
    "test:unit": "tsx --test tests/*.test.mts"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.17",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^6.1.1",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "expo": "~57.0.28",
    "expo-status-bar": "~57.0.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "mongoose": "^9.11.2",
    "motion": "^12.23.24",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "^0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "^13.16.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.3",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "mongodb-memory-server": "^11.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "main": "index.ts",
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
